# Copy this file to ".env" and fill it in. Never commit ".env".
# No map or geocoding API key is needed: the site uses OpenStreetMap + Leaflet + Nominatim (all free).

# Secret used by the admin page (/admin.html) to add or delete advisories.
# Use something long and random. If empty, the admin API is disabled.
ADMIN_TOKEN=

# Optional but recommended: your contact email. OpenStreetMap's Nominatim usage policy
# asks apps to identify themselves so they can reach you if there is a problem.
NOMINATIM_EMAIL=

PORT=3000
